-- 注意看！这里加上了 Assets. 必须和 C# 里的 namespace 一字不差！
local AppLog = CS.Assets.Scripts.Framework.Util.AppLog
local UIManager = CS.Assets.Scripts.Framework.Manager.UIManager
local UILayer = CS.Assets.Scripts.Framework.Manager.UILayer
local GameManager = CS.Assets.Scripts.Framework.Manager.GameManager
function Main()
    -- 下面这行不用动，依然是用 . 调用静态方法
    AppLog.LogSys("LuaMain", "老铁，我把家庭住址写对后，终于跨界成功了！")
    GameManager.UI:OpenUI("UIMain", "UIMain", UILayer.Back)
end