# ------------------------------------------------------------------------
# Unity 专属 Git 忽略规则配置 (标准版)
# 请将此文件放置在 Unity 工程的根目录下（与 Assets 文件夹同级）
# ------------------------------------------------------------------------

# [核心] 忽略 Unity 自动生成的庞大临时缓存和编译文件夹
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# [内存分析] 忽略内存快照（文件极大，通常不需要提交）
/[Mm]emoryCaptures/

# [录屏] 忽略录像文件
/[Rr]ecordings/

# [IDE] 忽略各种代码编辑器（VS/Rider/Cursor）自动生成的缓存、配置文件和项目工程文件
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.boop
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# [Meta后缀] 忽略引擎崩溃时或编译时生成的无用 meta 文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# [系统] 忽略操作系统自动生成的缩略图和缓存文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# [崩溃报告] 忽略崩溃时生成的系统信息
sysinfo.txt
crashlytics-build.properties

# [打包产物] 忽略直接打包出来的安装包或资产包，避免仓库爆炸
*.apk
*.aab
*.unitypackage
*.app


# [热更产物] 忽略自动化打包生成的 AssetBundle 及相关清单文件
*.ab
*.ab.meta
*.manifest
*.manifest.meta

# 忽略 StreamingAssets 目录下的所有自动生成内容 (如果该目录只用于输出打包产物)
/[Aa]ssets/[Ss]treaming[Aa]ssets/*
!/[Aa]ssets/[Ss]treaming[Aa]ssets/.gitkeep